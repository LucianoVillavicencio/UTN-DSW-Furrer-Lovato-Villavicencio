
# Google Client ID (igual al id del backend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# URL base de la API del backend
VITE_API_URL=http://localhost:3000/api/v1


# WhatsApp de atencion (solo digitos, formato internacional sin +)
# Ej: 5493410000000 -> se muestra como +54 9 341 000-0000
VITE_WHATSAPP_NUMBER=5490000000000

# Public key de Mercado Pago para el Card Payment Brick (front-end only, no es secreta)
VITE_MP_PUBLIC_KEY=

# Id de la terminal Point (debe coincidir con MP_POINT_TERMINAL_ID del backend)
VITE_MP_POINT_TERMINAL_ID=

# External POS id de la caja para cobros QR (debe coincidir con MP_QR_EXTERNAL_POS_ID del backend)
VITE_MP_QR_EXTERNAL_POS_ID=
