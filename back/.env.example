# Copiá este archivo como .env y completá con tus valores reales.

PORT=3000
NODE_ENV=development

# REQUERIDA — la aplicación no arranca sin ella.
# Controls two security-relevant behaviours, both opt-in by name: only the
# literal value "development" makes TypeORM auto-apply schema changes from the
# entities (never do this against a real database) and serves the Swagger
# document at /api. Any other value — production, staging, a typo — disables
# both. Use "production" in any real deployment.

# Base de datos MySQL. En producción, completá estos valores.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=flg

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# El valor real va en el .env (no versionado); esto es solo un ejemplo.


# Generá algo largo y aleatorio, ej: openssl rand -base64 48 (lo generas en la terminal)
JWT_SECRET=pegalo-aca
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:5173


# Cuenta de Gmail que envia las notificaciones del formulario de contacto.
# GMAIL_APP_PASSWORD es una "App Password" de Google, no la clave de la cuenta.
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_APP_PASSWORD=tu-app-password

# Mercado Pago — la app "FLG" ya existe (AppID 2538525704215137).
# Las credenciales reales van SOLO en .env, nunca en este archivo.
# MP_ENABLED debe ser exactamente "true" para activar cobros y el cron de renovación.
# Con MP_ENABLED=false el sistema sigue funcionando: efectivo, reembolsos en
# efectivo, pausas y planes multi-mes no dependen de Mercado Pago.
MP_ENABLED=false
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# Terminal Point Smart 1 en modo PDV. Formato TIPO__SERIAL.
MP_POINT_TERMINAL_ID=
# external_id de la caja a la que está asociado el QR impreso.
MP_QR_EXTERNAL_POS_ID=
